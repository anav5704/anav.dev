---
import BlogCard from "@components/BlogCard.astro";
import SearchInput from "@components/SearchInput";
import TagFilter from "@components/TagFilter";
import { getCollection } from "astro:content";
import ListLayout from "@layouts/list.astro";
import { tagToSlug } from "@utils/tags";

export async function getStaticPaths() {
    const blogs = await getCollection("blogs");
    const tags = [
        ...new Set(blogs.flatMap((blog) => blog.data.tags))
    ].filter((tag) => tag in tagToSlug);

    return tags.map((tag) => ({
        params: { tag: tagToSlug[tag] },
        props: { tag }
    }));
}

const { tag } = Astro.props;

const allBlogs = await getCollection("blogs");

const blogs = allBlogs
    .filter((blog) => blog.data.tags.includes(tag))
    .sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime());

const allTags = [
    ...new Set(allBlogs.flatMap((blog) => blog.data.tags))
].sort();
---

<ListLayout
    title={`Anav Chand | ${tag} Blogs`}
    description="I write about web development, software engineering, and DevOps, along with personal reflections on my university life and learning experiences."
    contentType="Blogs"
>
    <header>
        <h1>{`${tag} Blogs (${blogs.length})`}</h1>
        <p>
            I write about web development, software engineering, and DevOps,
            along with personal reflections on my university life and learning
            experiences.
        </p>
    </header>
    <div class="flex gap-3">
        <div class="w-3/4">
            <SearchInput placeholder="Search blogs" client:load />
        </div>
        <div class="w-1/4">
            <TagFilter
                tags={allTags}
                selected={tag}
                basePath="/blogs"
                client:load
            />
        </div>
    </div>
    <ul class="space-y-4">
        {
            blogs.map((blog) => (
                <li>
                    <BlogCard blog={blog} />
                </li>
            ))
        }
    </ul>
</ListLayout>
