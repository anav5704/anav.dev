---
import TableOfContents from "@components/TableOfContents.astro";
import RelatedLinks from "@components/RelatedLinks.astro";
import ProjectDetails from "@components/ProjectDetails";
import Pre from "@components/Pre.astro";
import ContentLayout from "@layouts/content.astro";
import { relatedTo } from "@utils/related";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const allProjects = await getCollection("projects");

    return allProjects.map((project) => ({
        params: { slug: project.id },
        props: { project }
    }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const blogs = await getCollection("blogs");
const projects = await getCollection("projects");
const related = relatedTo("projects", project, blogs, projects);

const url = new URL(Astro.url.pathname, Astro.site);
---

<ContentLayout
    contentType="Projects"
    title={project.data.metaTitle}
    description={project.data.metaDescription}
    createdAt={project.data.createdAt}
    updatedAt={project.data.createdAt}
>
    <ProjectDetails
        client:load
        url={url.href}
        title={project.data.title}
        repo={project.data.repo}
    />
    <TableOfContents headings={headings} />
    <article class="space-y-4 content">
        <Content components={{ pre: Pre }} />
    </article>
    <RelatedLinks items={related} />
</ContentLayout>
